# Provider actif : "openai" ou "ollama"
LLM_PROVIDER=ollama

# --- Mode openai ---
OPENAI_API_KEY=sk-proj-remplace-moi
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# --- Mode ollama ---
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL_LOCAL=qwen3-embedding:8b
CHAT_MODEL_LOCAL=gemma4:latest

# --- Commun aux deux modes ---
DOCS_DIR=docs
CHROMA_DIR=chroma_db
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=3
SYSTEM_PROMPT=Tu es un assistant qui repond aux questions des apprenants sur les contenus de formation. Reponds en francais.
